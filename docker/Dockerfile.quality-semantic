FROM harp-ae-gpu:quality-v0.3
COPY env/unified-resolved-lock.txt /tmp/generator-constraints.txt
RUN python -m pip install --no-cache-dir -c /tmp/generator-constraints.txt \
 timm==1.0.22 fairscale==0.4.13 fvcore==0.1.5.post20221221 iopath==0.1.9 \
 yacs==0.1.8 pycocotools==2.0.8 lvis==0.5.3 boto3==1.35.95 omegaconf==2.3.0
RUN export CPATH="$(python -c 'import pathlib;print(":".join(str(p) for p in pathlib.Path("/opt/python/lib/python3.10/site-packages/nvidia").glob("*/include")))')" \
 && FORCE_CUDA=1 TORCH_CUDA_ARCH_LIST=9.0 MAX_JOBS=2 python -m pip install --no-cache-dir --no-build-isolation --no-deps \
 git+https://github.com/facebookresearch/detectron2.git@247691a1c292654867deb35cabb27f18d75a1363
RUN python -m pip install --no-cache-dir -c /tmp/generator-constraints.txt black==24.10.0 hydra-core==1.3.2 \
 && python -m pip check && python -m pip freeze > /opt/harp/env/quality-semantic-resolved-lock.txt
